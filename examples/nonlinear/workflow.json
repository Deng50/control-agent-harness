{
  "schema_version": 1,
  "name": "nonlinear explicit simulator pipeline",
  "steps": [
    {
      "id": "nominal",
      "operation": "register_model",
      "inputs": {
        "model_path": "nominal.json"
      },
      "config": {
        "source": {
          "kind": "user_nominal",
          "description": "Declared demonstration nominal equations"
        }
      }
    },
    {
      "id": "reference",
      "operation": "register_model",
      "inputs": {
        "model_path": "reference.json"
      },
      "config": {
        "source": {
          "kind": "reference_simulator",
          "description": "Separate demonstration simulator, not measured data"
        }
      }
    },
    {
      "id": "data",
      "operation": "simulate_transitions",
      "inputs": {
        "nominal_model": {
          "stage": "nominal"
        },
        "reference_model": {
          "stage": "reference"
        }
      },
      "config": {
        "trajectories": 20,
        "steps": 24,
        "seed": 41
      }
    },
    {
      "id": "corrected",
      "operation": "train_residual",

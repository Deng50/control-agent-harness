          "entrypoint": "transition",
          "output_entrypoint": "observe",
          "parameters": {
            "gains": [
              0.24,
              0.18
            ],
            "bias": [
              0.01,
              -0.008,
              0.004
            ]
          },
          "interface": {
            "schema_version": 1,
            "name": "standalone-nonpolynomial-benchmark",
            "sample_time": 0.1,
            "time_semantics": "discrete_state_transition",
            "states": [
              {
                "name": "x1",
                "unit": "1",
                "lower": -2,
                "upper": 2
              },
              {
                "name": "x2",
                "unit": "1",
                "lower": -2,
                "upper": 2
              },
              {
                "name": "x3",
                "unit": "1",
                "lower": -2,
                "upper": 2
              }
            ],
            "controls": [
              {
                "name": "u1",
                "unit": "1",
                "lower": -1.5,
                "upper": 1.5
              },
              {
                "name": "u2",
                "unit": "1",
                "lower": -1.5,
                "upper": 1.5
              }
            ],
            "outputs": [
              {
                "name": "y1",
                "unit": "1",
                "lower": -2.1,
                "upper": 2.1
              },
              {
                "name": "y2",
                "unit": "1",
                "lower": -2.1,
                "upper": 2.1
              }
            ],
            "disturbances": [
              {
                "name": "d1",
                "unit": "1",
                "lower": -0.3,
                "upper": 0.3
              }
            ]
          }
        },
        "source": {
          "kind": "reference_simulator",
          "description": "Explicit separate benchmark parameters; not measured plant truth"
        }
      }
    },
    {
      "id": "data",
      "operation": "simulate_transitions",
      "inputs": {
        "nominal_model": {
          "stage": "nominal"
        },
        "reference_model": {
          "stage": "reference"
        }
      },
      "config": {
        "trajectories": 12,
        "steps": 16,
        "seed": 54
      }
    },
    {
      "id": "corrected",
      "operation": "train_residual",
      "inputs": {
        "nominal_model": {
          "stage": "nominal"
        },
        "dataset": {
          "stage": "data"
        }
      },
      "config": {
        "epochs": 100,
        "hidden_dims": [
          12,
          12
        ],
        "learning_rate": 0.008,
        "batch_size": 32,
        "patience": 30,
        "seed": 55
      }
    },
    {
      "id": "controller",

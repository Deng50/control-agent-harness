{
  "schema_version": 1,
  "name": "Reviewed standalone PyTorch benchmark; explicit simulation only",
  "steps": [
    {
      "id": "nominal",
      "operation": "register_python_model",
      "inputs": {
        "model_path": "model.py"
      },
      "config": {

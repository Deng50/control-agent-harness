      "config": {
        "architecture": "mlp",
        "input_dim": 4,
        "output_dim": 1,
        "epochs": 400,
        "hidden_dims": [
          48,
          32
        ],
        "learning_rate": 0.002,
        "batch_size": 64,
        "patience": 70,
        "dropout": 0,
        "seed": 145
      }
    },
    {
      "id": "optimized",
      "operation": "optimize_policy",
      "inputs": {
        "policy": {
          "stage": "imitation"
        },
        "model": {
          "stage": "corrected"
        }
      },
      "config": {
        "epochs": 35,
        "horizon": 6,
        "learning_rate": 0.0003,
        "batch_size": 24,
        "imitation_weight": 0.1,

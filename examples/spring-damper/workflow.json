{
  "schema_version": 1,
  "name": "二阶质量-弹簧-阻尼系统：模型校正、MPC 调参与控制器轻量化",
  "steps": [
    {
      "id": "nominal",
      "operation": "register_model",
      "inputs": {
        "model_path": "nominal.json"
      },
      "config": {
        "source": {
          "kind": "user_nominal",
          "description": "Declared continuous mass-spring-damper nominal equations; m=1 kg, c=0.8 N*s/m, k=2 N/m; exact ZOH at 0.2 s"
        }
      }
    },
    {
      "id": "reference",
      "operation": "register_model",
      "inputs": {
        "model_path": "reference.json"
      },
      "config": {
        "source": {
          "kind": "reference_simulator",
          "description": "Explicit separate continuous reference simulator; m=1.1 kg, c=1 N*s/m, k=2.3 N/m; exact ZOH; not measured plant data"
        }
      }
    },
    {
      "id": "data",
      "operation": "simulate_transitions",
      "inputs": {
        "nominal_model": {
          "stage": "nominal"
        },
        "reference_model": {
          "stage": "reference"
        }
      },
      "config": {
        "trajectories": 30,
        "steps": 35,
        "seed": 141
      }
    },
    {
      "id": "corrected",
      "operation": "train_residual",
      "inputs": {
        "nominal_model": {
          "stage": "nominal"
        },
        "dataset": {
          "stage": "data"
        }
      },
      "config": {
        "input_dim": 4,
        "output_dim": 2,
        "epochs": 300,
        "hidden_dims": [
          24,
          24
        ],
        "learning_rate": 0.005,
        "batch_size": 64,
        "patience": 50,
        "physics_weight": 0.1,
        "seed": 142
      }
    },
    {
      "id": "controller",
      "operation": "design_controller",
      "inputs": {
        "model": {
          "stage": "corrected"
        },
        "evaluation_model": {
          "stage": "reference"
        }
      },
      "config": {
        "parameters": {
          "horizon": 6,
          "q": 1,
          "r": 0.18,
          "s": 0.06
        },
        "parameter_space": {
          "r": {
            "lower": 0.0005,
            "upper": 0.2
          },
          "s": {
            "lower": 0.0001,
            "upper": 0.08
          }
        },
        "budget": 12,
        "seed": 143,
        "tuning_scenarios": [
          {
            "name": "spring-tuning",
            "initial_state": [
              -0.25,
              0.05
            ],
            "reference": [
              0.35
            ],
            "disturbance": [
              0.08
            ],
            "steps": 40
          }
        ],
        "verification_scenarios": [
          {
            "name": "spring-verification",
            "initial_state": [
              0.28,
              -0.1
            ],
            "reference": [
              -0.3
            ],
            "disturbance": [
              -0.1
            ],
            "steps": 40
          }
        ],
        "test_scenarios": [
          {
            "name": "spring-controller-test",
            "initial_state": [
              -0.18,
              0.12
            ],
            "reference": [
              0.37
            ],
            "disturbance": [
              -0.06
            ],
            "steps": 40
          }
        ]
      }
    },
    {
      "id": "expert",
      "operation": "collect_expert",
      "inputs": {
        "controller": {
          "stage": "controller"
        },
        "evaluation_model": {
          "stage": "reference"
        }
      },
      "config": {

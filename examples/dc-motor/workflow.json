{
  "schema_version": 1,
  "name": "DC motor speed: residual model, tuned MPC and lightweight policy",
  "steps": [
    {
      "id": "nominal",
      "operation": "register_model",
      "inputs": {
        "model_path": "nominal.json"
      },
      "config": {
        "source": {
          "kind": "user_nominal",
          "description": "Declared DC motor continuous nominal equations; exact ZOH at 0.1 s"
        }
      }
    },
    {
      "id": "reference",
      "operation": "register_model",
      "inputs": {
        "model_path": "reference.json"
      },
      "config": {
        "source": {
          "kind": "reference_simulator",
          "description": "Separate mathematical DC motor reference; not measured data"
        }
      }
    },
    {
      "id": "data",
      "operation": "simulate_transitions",
      "inputs": {
        "nominal_model": {
          "stage": "nominal"
        },
        "reference_model": {
          "stage": "reference"
        }
      },
      "config": {
        "trajectories": 30,
        "steps": 40,
        "seed": 241
      }
    },
    {
      "id": "corrected",
      "operation": "train_residual",
      "inputs": {
        "nominal_model": {
          "stage": "nominal"
        },
        "dataset": {
          "stage": "data"
        }
      },
      "config": {
        "input_dim": 4,
        "output_dim": 2,
        "epochs": 300,
        "hidden_dims": [
          24,
          24
        ],
        "learning_rate": 0.005,
        "batch_size": 64,
        "patience": 50,
        "physics_weight": 0.1,
        "seed": 242
      }
    },
    {
      "id": "controller",
      "operation": "design_controller",
      "inputs": {
        "model": {
          "stage": "corrected"
        },
        "evaluation_model": {
          "stage": "reference"
        }
      },
      "config": {
        "parameters": {
          "horizon": 6,
          "q": 1,
          "r": 0.15,
          "s": 0.04
        },
        "parameter_space": {
          "r": {
            "lower": 0.0005,
            "upper": 0.2
          },
          "s": {
            "lower": 0.0001,
            "upper": 0.08
          }
        },
        "budget": 12,
        "seed": 243,
        "tuning_scenarios": [
          {
            "name": "motor-tuning",
            "initial_state": [
              0,
              -5
            ],
            "reference": [
              14
            ],
            "disturbance": [
              0.04
            ],
            "steps": 30
          }
        ],
        "verification_scenarios": [
          {
            "name": "motor-verification",
            "initial_state": [
              1,
              6
            ],
            "reference": [
              -12
            ],
            "disturbance": [
              -0.05
            ],
            "steps": 30
          }
        ],
        "test_scenarios": [
          {
            "name": "motor-final-test",
            "initial_state": [
              -1,
              -3
            ],
            "reference": [
              16
            ],
            "disturbance": [
              0.06
            ],
            "steps": 30
          }
        ]
      }
    },
    {
      "id": "expert",
      "operation": "collect_expert",
      "inputs": {
        "controller": {
          "stage": "controller"
        },
        "evaluation_model": {
          "stage": "reference"
        }
      },
      "config": {

          "stage": "imitation"
        },
        "model": {
          "stage": "corrected"
        }
      },
      "config": {
        "epochs": 40,
        "horizon": 6,
        "learning_rate": 0.0003,
        "batch_size": 24,
        "imitation_weight": 0.1,
        "constraint_weight": 100,
